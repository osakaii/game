{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    // vite.config.ts импортирует плагин с расширением .ts: так его понимает и будущий нативный загрузчик конфига Vite.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "build",
    "vite.config.ts"
  ]
}
