{
  "name": "mecha",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "pnpm --filter @mecha/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.mjs",
    "hitboxes": "vitest run apps/client/test/player/pose-hitboxes.test.ts -u -t \"matches the character model\" && pnpm --filter @mecha/shared build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "happy-dom": "^21",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vitest": "^5"
  }
}
